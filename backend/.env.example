# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Chave secreta usada para assinar os tokens JWT. Gere a sua com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-por-voce

# Recuperação de senha: sem SMTP_HOST + EMAILS_FROM_EMAIL, a API retorna 503
# uniformemente, sem afirmar que enviou mensagem. Nunca inclua segredos no Git.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Defina este campo apenas quando configurar um remetente válido:
# EMAILS_FROM_EMAIL=contato@seu-dominio.com
EMAILS_FROM_NAME=EduTrack

# Limites por processo (produção multiworker exige armazenamento compartilhado).
RESET_REQUEST_COOLDOWN_SECONDS=60
RESET_REQUEST_WINDOW_SECONDS=900
RESET_REQUEST_EMAIL_LIMIT=3
RESET_REQUEST_IP_LIMIT=30
# BackgroundTasks não persiste os envios nem oferece retry após falhas/paradas.

# Banco de dados
# "sqlite" = funciona na hora, sem instalar nada (recomendado)
# "mssql"  = usa o SQL Server local (exige SQL Server Express + ODBC Driver 18)
DB_ENGINE=sqlite
SQLITE_PATH=edutrack.db

# Só usado se DB_ENGINE=mssql
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EduTrackDB
DB_DRIVER=ODBC Driver 18 for SQL Server
