# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Chave secreta usada para assinar os tokens JWT. Gere a sua com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-por-voce
ENVIRONMENT=development
# Em produção: ENVIRONMENT=production, segredo aleatório, URLs HTTPS e hosts reais.
TRUSTED_HOSTS=["localhost","127.0.0.1"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Recuperação de senha: sem SMTP_HOST + EMAILS_FROM_EMAIL, a API retorna 503
# uniformemente, sem afirmar que enviou mensagem. Nunca inclua segredos no Git.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Defina este campo apenas quando configurar um remetente válido:
# EMAILS_FROM_EMAIL=contato@seu-dominio.com
EMAILS_FROM_NAME=EduTrack

# Limites compartilhados no banco, inclusive entre múltiplos workers da API.
RESET_REQUEST_COOLDOWN_SECONDS=60
RESET_REQUEST_WINDOW_SECONDS=900
RESET_REQUEST_EMAIL_LIMIT=3
RESET_REQUEST_IP_LIMIT=30
# Execute separadamente: python -m app.workers.email_worker
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_SECONDS=30
MAIL_LEASE_SECONDS=180
MAIL_POLL_SECONDS=5
MAIL_RETENTION_DAYS=7

# Banco de dados
# "sqlite" = funciona na hora, sem instalar nada (recomendado)
# "mssql"  = usa o SQL Server local (exige SQL Server Express + ODBC Driver 18)
DB_ENGINE=sqlite
SQLITE_PATH=edutrack.db

# Só usado se DB_ENGINE=mssql
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EduTrackDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true
# SQL Server em produção exige DB_TRUST_SERVER_CERTIFICATE=false.
