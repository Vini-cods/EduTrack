# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Chave secreta usada para assinar os tokens JWT. Gere a sua com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-por-voce

# Banco de dados
# "sqlite" = funciona na hora, sem instalar nada (recomendado)
# "mssql"  = usa o SQL Server local (exige SQL Server Express + ODBC Driver 18)
DB_ENGINE=sqlite
SQLITE_PATH=edutrack.db

# Só usado se DB_ENGINE=mssql
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EduTrackDB
DB_DRIVER=ODBC Driver 18 for SQL Server
