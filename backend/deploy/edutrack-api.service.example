[Unit]
Description=EduTrack API
After=network-online.target
Wants=network-online.target

[Service]
User=edutrack
Group=edutrack
WorkingDirectory=/opt/edutrack/backend
EnvironmentFile=/etc/edutrack/backend.env
ExecStart=/opt/edutrack/backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log --log-config deploy/logging.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/edutrack
UMask=0077

[Install]
WantedBy=multi-user.target
