# Exemplo para um host Linux. Defina EDUTRACK_HOST e EDUTRACK_DIST no serviço Caddy.
# Não foi publicado: requer domínio/DNS e provedor SMTP configurados pelo operador.
{$EDUTRACK_HOST} {
    encode zstd gzip
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /health/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        root * {$EDUTRACK_DIST}
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
}
